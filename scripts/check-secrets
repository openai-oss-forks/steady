#!/bin/sh
set -eu

cd "$(dirname "$0")/.."
if ! command -v gitleaks >/dev/null 2>&1; then
  echo "Install approved Gitleaks 8.30.1 before committing." >&2
  exit 2
fi
if [ "$(gitleaks version)" != "8.30.1" ]; then
  echo "Expected Gitleaks 8.30.1; review version changes explicitly." >&2
  exit 2
fi
case "${1:-}" in
  "") exec gitleaks dir --config .gitleaks.toml --redact --no-banner . ;;
  --staged) exec gitleaks git --config .gitleaks.toml --pre-commit --staged --redact --no-banner . ;;
  *) echo "Usage: scripts/check-secrets [--staged]" >&2; exit 2 ;;
esac
